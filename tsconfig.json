{
  // The type check for Bun and Node (Bun migration, 2026-10-12). Neither runtime checks types,
  // and `deno check` is going away with Deno, so `tsc` is the check.
  //
  // Scope: the published `.d.ts` files (what JSR serves to every consumer), the shipped `.js`
  // (checkJs against its own JSDoc, since 2026-10-13: nothing checked it before), and scripts/.
  // An import of "./x.js" resolves to x.d.ts first, so the shipped modules see each other through
  // the PUBLISHED types, as a consumer does.
  //
  // Lint-like flags (owner, 2026-10-13: TypeScript covers what it can; Biome does the rest):
  // noUnusedLocals, noUnusedParameters, allowUnreachableCode/allowUnusedLabels false,
  // noImplicitOverride.
  //
  // `types: ["node"]` and NOT bun: code must run on Bun and Node (owner, 2026-10-12), so a
  // Bun-only API has to fail this check. @types/node is pinned to 22.18, the Node floor, so an
  // API newer than the floor fails it too.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noImplicitOverride": true,
    "allowJs": true,
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "*.d.ts",
    "universal-wasm-loader.js",
    "abi.js",
    "wit-parser.js",
    "wasi.js",
    "scripts/**/*.ts"
  ]
}
